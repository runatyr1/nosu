{$NOSU_SITE_ADDRESS} {
    import /etc/caddy/tls-routes.caddy

    encode zstd gzip

    @relay path /relay /relay/*
    handle @relay {
        rewrite * /
        reverse_proxy ditto-relay:13131
    }

    @syncSession path /relay-sync/session /relay-sync/session/* /relay-sync/capabilities
    handle @syncSession {
        uri strip_prefix /relay-sync
        reverse_proxy ditto-sync:13132
    }

    handle /relay-sync/* {
        respond "Not found" 404
    }

    handle /groups-app {
        redir * /groups-app/ 308
    }

    handle /groups-app/* {
        reverse_proxy groups:80
    }

    import /etc/caddy/dashboard-routes.caddy

    handle {
        reverse_proxy nosu:3400
    }
}

:8080 {
    respond /healthz "ok" 200
}

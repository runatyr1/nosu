{
  "name": "nostrix",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:social": "pnpm --filter web dev",
    "dev:groups": "npm --prefix apps/groups run dev",
    "dev:trending": "pnpm --filter @nostrich/api trending",
    "install:groups": "npm_config_cache=${TMPDIR:-/tmp}/nostrix-npm-cache npm --prefix apps/groups ci",
    "typecheck:groups": "npm exec --prefix apps/groups -- tsc --noEmit --project apps/groups/tsconfig.json",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @nostrich/api db:generate",
    "db:push": "pnpm --filter @nostrich/api db:push",
    "db:migrate": "pnpm --filter @nostrich/api db:migrate"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.3"
  }
}
